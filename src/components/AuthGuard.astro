---
// Redirects to / if not signed in. Place inside AppLayout.
// Preserves the original requested URL via ?next= so login can return there.
---

<script is:inline>
  (function () {
    function check() {
      if (!window.firebase || !window.firebase.auth) {
        return setTimeout(check, 60);
      }
      window.firebase.auth().onAuthStateChanged(function (user) {
        // Owner-Seiten brauchen echte E-Mail-Auth. Anonyme (Kunden-)Sessions
        // werden wie "nicht eingeloggt" behandelt → Login, KEIN team-Eintrag.
        if (!user || user.isAnonymous) {
          var here = location.pathname + location.search;
          var next = here && here !== "/" ? "?next=" + encodeURIComponent(here) : "";
          window.location.replace("/" + next);
          return;
        }
        window.ME = {
          uid: user.uid,
          email: user.email,
          name: (user.email || "").split("@")[0],
        };

        var teamRef = window.fb.ref("team/" + user.uid);
        teamRef.once("value").then(function (snap) {
          var existing = snap.val() || {};
          // NUR Profil schreiben — NIEMALS die Rolle. Rollen vergibt ausschließlich
          // ein Admin (siehe DB-Regeln). Neue Nutzer bekommen so einen rollenlosen
          // "Pending"-Eintrag, den ein Admin unter Team freigibt. Das verhindert die
          // alten Geister-Rollen (anonyme/fremde Sessions, die sich selbst member setzten).
          teamRef.update({
            uid: user.uid,
            email: user.email,
            name: existing.name || window.ME.name,
          }).catch(function () {});

          if (existing.role) {
            // Freigegebenes Team-Mitglied → normal weiter.
            window.ME.role = existing.role;
            setupPresence(user);
            document.dispatchEvent(
              new CustomEvent("auth-ready", { detail: window.ME })
            );
          } else {
            // Noch nicht freigeschaltet → Pending-Screen, KEIN auth-ready
            // (die Seite lädt keine Owner-Daten, die der Nutzer eh nicht lesen darf).
            showPending(user);
          }
        }).catch(function () {
          showPending(user);
        });
      });
    }

    function setupPresence(user) {
      var pres = window.fb.ref("presence/" + user.uid);
      pres.update({
        online: true,
        lastSeen: window.fb.ts(),
        uid: user.uid,
        email: user.email,
        name: window.ME.name,
      });
      pres.onDisconnect().update({
        online: false,
        lastSeen: window.fb.ts(),
      });

      // Heartbeat: alle 30s lastSeen aktualisieren, damit der Owner-Filter
      // (presence/<uid>/lastSeen aelter als TTL = offline) Browser-Crashes
      // erkennt und keine Zombie-Online-Anzeigen entstehen.
      // Pausiert wenn Tab unsichtbar (Browser drosseln Timer dort sowieso).
      var HEARTBEAT_INT = (window.appUI && window.appUI.CONST.PRESENCE_HEARTBEAT_MS) || 30000;
      function beat() {
        if (document.visibilityState !== "visible") return;
        pres.update({ online: true, lastSeen: window.fb.ts() }).catch(function () {});
      }
      var heartbeatId = setInterval(beat, HEARTBEAT_INT);
      document.addEventListener("visibilitychange", function () {
        if (document.visibilityState === "visible") beat();
      });
      // Beim Verlassen Cleanup (verhindert offene Intervals nach Logout)
      window.addEventListener("pagehide", function () {
        clearInterval(heartbeatId);
      });
    }

    // Vollbild-Hinweis für noch nicht freigeschaltete Konten.
    function showPending(user) {
      try {
        if (document.getElementById("uw-pending")) return;
        var ov = document.createElement("div");
        ov.id = "uw-pending";
        ov.style.cssText =
          "position:fixed;inset:0;z-index:100000;background:#faf9f7;display:flex;" +
          "flex-direction:column;align-items:center;justify-content:center;gap:14px;" +
          "text-align:center;padding:24px;font-family:Montserrat,system-ui,sans-serif;color:#111";
        // Nur STATISCHE Markup-Strings via innerHTML; die E-Mail wird unten
        // per textContent gesetzt (keine Interpolation von Nutzerdaten ins HTML).
        ov.innerHTML =
          '<div style="font-size:40px" aria-hidden="true">⏳</div>' +
          '<div style="font-size:18px;font-weight:800">Fast geschafft</div>' +
          '<div style="font-size:13px;color:#555;max-width:360px;line-height:1.55">Dein Konto ist angelegt, aber ein Admin muss dich noch freischalten. Meld dich kurz bei deinem Team — danach hast du Zugriff.</div>' +
          '<div id="uw-pending-email" style="font-size:11px;color:#999"></div>' +
          '<button id="uw-pending-logout" type="button" style="margin-top:8px;background:#111;color:#fff;border:0;border-radius:10px;padding:10px 18px;font-weight:700;font-size:13px;cursor:pointer">Abmelden</button>';
        (document.body || document.documentElement).appendChild(ov);
        var em = document.getElementById("uw-pending-email");
        if (em) em.textContent = user.email || "";
        var lo = document.getElementById("uw-pending-logout");
        if (lo) lo.addEventListener("click", function () {
          window.firebase.auth().signOut()
            .then(function () { location.replace("/"); })
            .catch(function () { location.replace("/"); });
        });
      } catch (e) {}
    }

    check();
  })();
</script>
